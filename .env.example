# DIP-14 - Last updated: 2026-10-18
# Configuration template for PharmaStock. Copy this file to .env in the
# repository root and replace the placeholders. .env is ignored by Git (see
# .gitignore); real values are never committed. The same .env is read by
# Docker Compose (docker-compose.yml) and by the backend (backend/app/core/config.py).

# --- PostgreSQL (docker-compose.yml, service "db") ----------------------------
POSTGRES_USER=pharmastock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pharmastock
# Host port published by Docker Compose; keep it in sync with DATABASE_URL.
POSTGRES_PORT=5432

# --- Backend ------------------------------------------------------------------
# SQLAlchemy URL used by the backend running on the host against the Compose database.
DATABASE_URL=postgresql+psycopg://pharmastock:change-me@localhost:5432/pharmastock
# development | test | production
APP_ENVIRONMENT=development
# Signing key for access tokens (FR-14, planned). Use a long random value for
# any shared or deployed instance.
SECRET_KEY=change-me
LOG_LEVEL=INFO
# Comma-separated browser origins allowed by CORS (Vite development server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
